{
  "name": "xiaoli",
  "version": "0.2.0",
  "description": "先问完再执行的终端 AI 同事：追问、计划、确认、执行、暂停恢复。",
  "main": "dist/main.js",
  "bin": {
    "xiaoli": "./bin/xiaoli.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "README.en.md",
    "README.ja.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "eval": "tsx eval/run.ts",
    "demo": "tsx eval/demo.ts",
    "prepublishOnly": "npm run build && npm test && npm run eval"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "developer-tools",
    "coding-assistant",
    "autonomous-agent",
    "deepseek",
    "sqlite",
    "safety"
  ],
  "author": "tangjinchun",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tangjinchun/xiaoli.git"
  },
  "bugs": {
    "url": "https://github.com/tangjinchun/xiaoli/issues"
  },
  "homepage": "https://github.com/tangjinchun/xiaoli",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "commander": "^12.0.0",
    "openai": "^4.50.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.11.0",
    "tsx": "^4.22.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
